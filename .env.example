# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/passtheaux

# JWT Authentication
JWT_SECRET=passtheaux_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Spotify Web API Credentials (https://developer.spotify.com/dashboard)
# 1. Create an app in Spotify Developer Dashboard
# 2. Add Redirect URI: http://localhost:5000/api/auth/spotify/callback (or http://localhost:5173/auth/spotify/callback)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/auth/spotify/callback
