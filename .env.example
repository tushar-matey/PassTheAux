# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/passtheaux

# JWT Authentication
JWT_SECRET=passtheaux_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# YouTube Data API v3 (https://console.cloud.google.com/)
# 1. Create a project in Google Cloud Console
# 2. Go to APIs & Services > Library and enable "YouTube Data API v3"
# 3. Go to APIs & Services > Credentials > Create Credentials > API Key
# 4. Paste the API key below (no OAuth required)
YOUTUBE_API_KEY=your_youtube_api_key_here
